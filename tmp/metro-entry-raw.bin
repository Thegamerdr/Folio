        head: 'Ready.',
        body: 'Melo will get quieter as it learns you.'
      }
    },
    // ## Shortfall moment
    short: {
      head: amount => `Short by **${amount}.**`,
      body: days => `${days} days left. Here's what would close it.`,
      move: {
        pause: name => `Pause ${name} this cycle`,
        pot: pot => `Borrow from ${pot}`,
        cap: amount => `Hold spending at ${amount}/day`
      },
