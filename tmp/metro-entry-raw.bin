      subtitle: 'A quiet minute. Just you and the numbers.',
      cta: {
        begin: 'Begin'
      },
      worked: {
        head: 'What **worked.**'
      },
      slipped: {
        head: 'What **slipped.**'
      },
      next: {
        head: 'Set the **next one.**'
      },
