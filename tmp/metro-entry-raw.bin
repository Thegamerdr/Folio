      empty: 'Nothing hidden yet.',
      unhide: 'Un-hide',
      done: 'Done'
    },
    // ## Pots
    pots: {
      title: 'Pots',
      empty: {
        head: 'No pots **yet.**',
        body: 'A pot is money set aside for one thing. Holiday, buffer, vet bill.',
        cta: 'Start a pot'
      },
      add: {
        title: 'New **pot.**'
      },
      fund: {
        title: 'Move money in'
      }
