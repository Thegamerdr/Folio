        tight: "It's **tight**, but you make it.",
        short: amount => `You're **short** by ${amount}.`
      },
      days_left: n => `${n} days to payday`,
      spend_today: 'Spent today',
      left_today: 'Left for today'
    },
    // ## Payday ritual
    ritual: {
