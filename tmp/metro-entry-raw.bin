    stability: days => `${days} days to payday →`,
    debt: days => `${days} days to payday →`,
    reset: days => `${days} days to payday →`,
    growth: () => 'This month →',
    optimizer: () => 'This month →',
    planning: () => 'This month →',
    household: () => 'This month →',
    irregular: () => 'Your runway →',
    lowVis: () => 'Getting a picture →'
  };
