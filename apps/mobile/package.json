{
  "name": "@folio/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "pnpm typecheck",
    "doctor": "expo-doctor",
    "eas:android:development": "pnpm dlx eas-cli@20.3.0 build --platform android --profile development",
    "eas:android:tester": "pnpm dlx eas-cli@20.3.0 build --platform android --profile tester",
    "eas:ios:development": "pnpm dlx eas-cli@20.3.0 build --platform ios --profile development",
    "ios": "expo run:ios",
    "native:apk:android": "cd android && gradlew.bat :app:assembleRelease",
    "native:install:android": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "native:prebuild": "expo prebuild",
    "native:prebuild:clean": "expo prebuild --clean",
    "native:smoke:android": "expo run:android --variant debug",
    "native:smoke:ios": "expo run:ios",
    "start": "expo start",
    "typecheck": "tsc -b --pretty false"
  },
  "op-sqlite": {
    "sqlcipher": true,
    "fts5": true,
    "performanceMode": true
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~56.0.15",
    "@folio/ai-contracts": "workspace:*",
    "@folio/business-workspace": "workspace:*",
    "@folio/calendar-engine": "workspace:*",
    "@folio/domain": "workspace:*",
    "@folio/finance-engine": "workspace:*",
    "@folio/first-minute": "workspace:*",
    "@folio/import-engine": "workspace:*",
    "@folio/melo-engine": "workspace:*",
    "@folio/melo-policy": "workspace:*",
    "@folio/open-banking": "workspace:*",
    "@folio/plan-engine": "workspace:*",
    "@folio/release-readiness": "workspace:*",
    "@folio/storage": "workspace:*",
    "@folio/store-release": "workspace:*",
    "@folio/sync": "workspace:*",
    "@folio/today-engine": "workspace:*",
    "@folio/ui": "workspace:*",
    "@noble/ciphers": "^2.2.0",
    "@op-engineering/op-sqlite": "17.0.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-iap": "^4.3.6",
    "expo-image-picker": "~56.0.18",
    "expo-linking": "~56.0.14",
    "expo-local-authentication": "~56.0.4",
    "expo-notifications": "~56.0.19",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
