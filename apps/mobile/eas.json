{
  "cli": {
    "appVersionSource": "local",
    "version": ">= 20.3.0"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MELO_GATEWAY_URL": "$EXPO_PUBLIC_MELO_GATEWAY_URL",
        "EXPO_PUBLIC_MELO_GATEWAY_TOKEN": "$EXPO_PUBLIC_MELO_GATEWAY_TOKEN"
      }
    },
    "tester": {
      "channel": "tester",
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MELO_GATEWAY_URL": "$EXPO_PUBLIC_MELO_GATEWAY_URL",
        "EXPO_PUBLIC_MELO_GATEWAY_TOKEN": "$EXPO_PUBLIC_MELO_GATEWAY_TOKEN"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_MELO_GATEWAY_URL": "$EXPO_PUBLIC_MELO_GATEWAY_URL",
        "EXPO_PUBLIC_MELO_GATEWAY_TOKEN": "$EXPO_PUBLIC_MELO_GATEWAY_TOKEN"
      }
    }
  }
}
