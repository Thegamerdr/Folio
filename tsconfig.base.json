{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@folio/ai-contracts": ["packages/ai-contracts/src/index.ts"],
      "@folio/business-workspace": ["packages/business-workspace/src/index.ts"],
      "@folio/calendar-engine": ["packages/calendar-engine/src/index.ts"],
      "@folio/crypto": ["packages/crypto/src/index.ts"],
      "@folio/domain": ["packages/domain/src/index.ts"],
      "@folio/event-engine": ["packages/event-engine/src/index.ts"],
      "@folio/finance-engine": ["packages/finance-engine/src/index.ts"],
      "@folio/first-minute": ["packages/first-minute/src/index.ts"],
      "@folio/import-engine": ["packages/import-engine/src/index.ts"],
      "@folio/melo-policy": ["packages/melo-policy/src/index.ts"],
      "@folio/open-banking": ["packages/open-banking/src/index.ts"],
      "@folio/plan-engine": ["packages/plan-engine/src/index.ts"],
      "@folio/policy-packs": ["packages/policy-packs/src/index.ts"],
      "@folio/release-gate": ["packages/release-gate/src/index.ts"],
      "@folio/release-readiness": ["packages/release-readiness/src/index.ts"],
      "@folio/search-engine": ["packages/search-engine/src/index.ts"],
      "@folio/storage": ["packages/storage/src/index.ts"],
      "@folio/store-release": ["packages/store-release/src/index.ts"],
      "@folio/sync": ["packages/sync/src/index.ts"],
      "@folio/testing": ["packages/testing/src/index.ts"],
      "@folio/today-engine": ["packages/today-engine/src/index.ts"],
      "@folio/ui": ["packages/ui/src/index.ts"]
    }
  }
}
