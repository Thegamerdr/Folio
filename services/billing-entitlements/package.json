{
  "name": "@melo/billing-entitlements",
  "version": "0.0.0",
  "private": true,
  "description": "Server-verified Google Play entitlement grants for Melo.",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "readiness": "node scripts/check-readiness.mjs",
    "readiness:activation": "node scripts/check-readiness.mjs --activation",
    "secret:put-google-email": "wrangler secret put GOOGLE_SERVICE_ACCOUNT_EMAIL --config wrangler.jsonc",
    "secret:put-google-private-key": "wrangler secret put GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.20.0"
  }
}
