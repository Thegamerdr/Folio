{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "melo-billing-entitlements",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "node-fetch": "./src/apple-fetch.ts"
  },
  "vars": {
    "PACKAGE_NAME": "com.folio.v2.greenfield",
    "APPLE_BUNDLE_ID": "com.folio.v2.greenfield",
    "APPLE_APP_ID": "",
    "APPLE_ENVIRONMENT": "",
    "GOOGLE_TOKEN_URI": "https://oauth2.googleapis.com/token",
    "ENTITLEMENT_ISSUER": "https://melo-billing-entitlements.tgdroppin.workers.dev",
    "ENTITLEMENT_AUDIENCE": "com.folio.v2.greenfield",
    "ENTITLEMENT_SIGNING_KEY_ID": "melo-billing-ed25519-2026-07",
    "ENTITLEMENT_SIGNING_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"x\":\"OKponTUZ9ZP1APZpvUeUK5BmKmlJm8FZQ5IDAd92HL8\",\"kty\":\"OKP\"}",
    "ALLOWED_ORIGINS": "",
  },
  "kv_namespaces": [
    {
      "binding": "ENTITLEMENTS",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
