{
  "name": "@melo/open-banking-service",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-isolated Open Banking adapter for Melo.",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "readiness": "node scripts/check-readiness.mjs",
    "readiness:remote": "node scripts/check-readiness.mjs --remote",
    "readiness:activation": "node scripts/check-readiness.mjs --remote --require-secrets",
    "secret:put-client-id": "wrangler secret put TRUELAYER_CLIENT_ID",
    "secret:put-client-secret": "wrangler secret put TRUELAYER_CLIENT_SECRET",
    "secret:put-encryption-key": "node scripts/put-encryption-key.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.20.0"
  }
}
