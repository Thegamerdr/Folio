{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "melo-cloud-vault",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLERK_ISSUER": "https://united-giraffe-33.clerk.accounts.dev",
    "CLERK_JWKS_URL": "https://united-giraffe-33.clerk.accounts.dev/.well-known/jwks.json",
    "MAX_BACKUP_BYTES": "4194304",
    "ALLOWED_ORIGINS": "",
    "PUBLIC_ACCOUNT_DELETION_URL": "",
  },
  "kv_namespaces": [
    {
      "binding": "VAULTS",
      "id": "1509b2b04d7449b39f6797db9ee13434",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_WORKSPACES",
        "class_name": "SyncWorkspaceDurableObject",
      },
      {
        "name": "BACKUP_WORKSPACES",
        "class_name": "BackupWorkspaceDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-sync-workspaces",
      "new_sqlite_classes": ["SyncWorkspaceDurableObject"],
    },
    {
      "tag": "v2-backup-workspaces",
      "new_sqlite_classes": ["BackupWorkspaceDurableObject"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
