{
  "name": "folio-v2-greenfield",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:constitution": "node tooling/scripts/check-constitution-gate.mjs",
    "check:operations-readiness": "node tooling/scripts/check-operations-readiness.mjs",
    "check:product-gates": "node tooling/scripts/check-product-canonical-gates.mjs",
    "check:release-blockers": "node tooling/scripts/check-release-blockers.mjs",
    "check:release-foundation": "node tooling/scripts/check-release-foundation.mjs",
    "check:samples": "node tooling/scripts/check-synthetic-data.mjs",
    "check:store-declarations": "node tooling/scripts/check-store-declarations.mjs",
    "check:v1-boundary": "node tooling/scripts/check-v1-boundary.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:contracts",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:boundaries && pnpm check:v1-boundary && pnpm check:samples && pnpm check:constitution && pnpm check:product-gates && pnpm check:operations-readiness && pnpm check:store-declarations && pnpm check:release-blockers && pnpm check:release-foundation && pnpm format:check",
    "lint:boundaries": "node tooling/scripts/check-boundaries.mjs",
    "mobile:doctor": "pnpm --filter @folio/mobile doctor",
    "mobile:install-check": "pnpm --filter @folio/mobile exec expo install --check",
    "mobile:install:android": "pnpm --filter @folio/mobile native:install:android",
    "mobile:apk:android": "pnpm --filter @folio/mobile native:apk:android",
    "mobile:prebuild": "pnpm --filter @folio/mobile exec expo prebuild --clean --no-install",
    "mobile:smoke:android": "pnpm --filter @folio/mobile native:smoke:android",
    "mobile:smoke:ios": "pnpm --filter @folio/mobile native:smoke:ios",
    "mobile:start": "pnpm --filter @folio/mobile start",
    "billing:preflight": "pnpm --filter @melo/billing-entitlements readiness",
    "billing:readiness": "pnpm --filter @melo/billing-entitlements readiness:activation",
    "billing:secret:google-email": "pnpm --filter @melo/billing-entitlements secret:put-google-email",
    "billing:secret:google-private-key": "pnpm --filter @melo/billing-entitlements secret:put-google-private-key",
    "open-banking:preflight": "pnpm --filter @melo/open-banking-service readiness:remote",
    "open-banking:readiness": "pnpm --filter @melo/open-banking-service readiness:activation",
    "open-banking:secret:client-id": "pnpm --filter @melo/open-banking-service secret:put-client-id",
    "open-banking:secret:client-secret": "pnpm --filter @melo/open-banking-service secret:put-client-secret",
    "open-banking:secret:encryption-key": "pnpm --filter @melo/open-banking-service secret:put-encryption-key",
    "operations:guard": "node tooling/scripts/check-operations-readiness.mjs --require-ready",
    "operations:status": "node tooling/scripts/check-operations-readiness.mjs",
    "release:guard": "node tooling/scripts/check-release-blockers.mjs --require-ready",
    "release:status": "node tooling/scripts/check-release-blockers.mjs",
    "store:guard": "node tooling/scripts/check-store-declarations.mjs --require-ready",
    "store:status": "node tooling/scripts/check-store-declarations.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b tsconfig.packages.json --pretty false && pnpm typecheck:gateway && pnpm typecheck:cloud-vault && pnpm typecheck:open-banking-service && pnpm typecheck:billing-entitlements",
    "typecheck:billing-entitlements": "pnpm --filter @melo/billing-entitlements typecheck",
    "typecheck:cloud-vault": "pnpm --filter @melo/cloud-vault typecheck",
    "typecheck:gateway": "pnpm --filter @folio/ai-gateway typecheck",
    "typecheck:open-banking-service": "pnpm --filter @melo/open-banking-service typecheck",
    "validate:contracts": "cd docs/source-package && python testing/validate_package.py && python testing/validate_fixture_consistency.py"
  },
  "op-sqlite": {
    "sqlcipher": true,
    "fts5": true,
    "performanceMode": true
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
