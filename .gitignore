node_modules/
dist/
coverage/
.turbo/
.expo/
.pnpm-patches/
.DS_Store
*.log
*.tsbuildinfo
# Expo prebuild regenerates the app's native dirs — ignore ONLY the top-level app android/ios
# (anchored), NEVER local Expo module native code under modules/*/{android,ios} (expo-doctor requires
# local-module native code to be tracked). Native BUILD output anywhere is still ignored below.
/apps/mobile/android/
/apps/mobile/ios/
!apps/mobile/android/.gitkeep
!apps/mobile/ios/.gitkeep

# Gradle / Xcode BUILD output anywhere (incl. inside local modules — the module SOURCE is tracked,
# only the generated build/ output is ignored).
**/android/build/
**/android/.cxx/
**/ios/build/
**/*.xcuserdata/

# Wrangler local secrets (OpenRouter key for local gateway dev) — never commit
.dev.vars
**/.dev.vars

# Wrangler local cache/state
**/.wrangler/

# Expo local env (EXPO_PUBLIC_* gateway URL/token — weak in-app token, not committed)
apps/mobile/.env
